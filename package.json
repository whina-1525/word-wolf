{
  "name": "word-wolf",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "tsx functions/src/logic.test.ts",
    "icons": "node scripts/make-icons.mjs",
